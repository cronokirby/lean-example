  (oracle_tape : U) (actions : Slice (nsl.Action Clause0_Ct))
  (secret : Std.Usize) (n : Std.U64) :
  Result Bool
  := do
  let io ← nsl.IdealOracle.new PkeInst TapeInst1 oracle_tape
  let ideal ←
