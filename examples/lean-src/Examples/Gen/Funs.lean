      (nsl.IdealOracle.Insts.ExamplesNslOracle PkeInst TapeInst1)
      { inner := tape, session := secret, nonce := n } io
  let ((_, seen), ideal1) ←
    nsl.run PkeInst.coremarkerCopyInst
